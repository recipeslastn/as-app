{
    "name": "clippings/package-template",
    "description": "Package Template",
    "minimum-stability": "dev",
    "license": "MIT",
    "type": "composer-init-template",
    "authors": [
        {
            "name": "Kevin"
        }
    ],
    "require": {
        "php":"^8.0",
        "ext-pdo":"*",
        "ext-pdo_mysql":"*",
        "symfony/cache":"^6.1",
        "predis/predis":"^2.0"
    },
    "require-dev": {
        "phpunit/phpunit":"^9.5"
    },
    "autoload": {
        "prs-4":{
            "APP\\":"src"
        }
    },
     "scripts": {
        "run-phpunit":"vendor/bin/phpunit"
     }
}
